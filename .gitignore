# Visual Studio 2015 user specific files
.vs/

# These project files can be generated by the engine
*.sln

# Rider
.idea/

# Visual Studio Code
.vscode/

# Compiled source files for the engine to use
Binaries/*
Intermediate/*
Plugins/**/Binaries/*
Plugins/**/Intermediate/*
Plugins/Developer/*
Saved/*

# Builds
Build/*
BuildOutput/*

# Built data for maps
*_BuiltData.uasset

# Cache files for the editor to use
DerivedDataCache/*

# Claude Code 로컬 권한 설정 (머신 의존, 절대 경로 포함). 공통 권한은 .claude/settings.json 에서 관리.
.claude/settings.local.json

# docs 전용 레포지토리 설정
*.uproject
Content/*
Plugins/*
Platforms/*
Config/*
Source/*

# 분석·학습 보조 도구 — 정책 검사 스크립트는 docs/tools/ 로 옮겨 추적, 자동 생성·검증 산출물만 ignore
docs/tools/node_modules/
docs/tools/verify-shots/